# Supabase (solo lectura, anon key)
NEXT_PUBLIC_SUPABASE_URL=https://jqhpmlmtopmtgxqxfyab.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No se necesita API key de mapas: el mapa usa Leaflet con teselas de
# Esri World Imagery, que no piden clave ni facturacion.


# Registros de ingreso de la porteria (Airtable, base "Registro Visitantes").
# SIN prefijo NEXT_PUBLIC_ a proposito: es un token con permiso de escritura
# sobre cedulas, nombres y placas, y solo lo usa la ruta de servidor
# app/api/porteria. Sin esta variable la app corre igual: la ficha de la
# porteria avisa que falta en vez de quedarse en blanco.
AIRTABLE_GUAICARAMO_VISITAS_API_KEY=
