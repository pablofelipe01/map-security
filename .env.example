# Supabase (solo lectura, anon key)
NEXT_PUBLIC_SUPABASE_URL=https://jqhpmlmtopmtgxqxfyab.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No se necesita API key de mapas: el mapa usa Leaflet con teselas de
# Esri World Imagery, que no piden clave ni facturacion.

# Antenas que todavía no están en la tabla `mesh_sites`, para poder verlas en el
# mapa mientras se corre el INSERT (ver lib/red.ts → antenasDelEntorno).
# Es una lista JSON. Se pintan siempre en gris, "sin datos": sin sondeos no hay
# nada que afirmar sobre el enlace.
#
# ⚠️ Las coordenadas reales NO van aquí: este archivo SÍ está versionado y el
# repositorio es público. El valor de verdad va en .env.local, que no lo está.
NEXT_PUBLIC_ANTENAS_EXTRA=[{"site_id":"ejemplo","site_name":"Ejemplo","role":"repetidor","lat":0,"lon":0}]
